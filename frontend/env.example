# ==============================================================================
# Variables de entorno para el contenedor Nginx del frontend (frontend/env.example)
# Sin secretos ni valores reales en este archivo versionado
# ==============================================================================

# Host interno y puerto del servicio backend hacia donde Nginx proxifica /api/
# En Docker Compose local usar: backend:8000
# En Easypanel usar el host interno de red privada (ej: localhost_libreria-backend:8000)
API_UPSTREAM=proyecto_backend:8000
